\name{sum_values}
\alias{sum_values}
\title{Sum Values}
\description{
A function whose example hides ordinary, fast code in \code{\\dontrun{}}.
}
\usage{
sum_values(x)
}
\arguments{
\item{x}{A numeric vector.}
}
\value{
A numeric vector the length of \code{x}.
}
\examples{
\dontrun{
sum_values(1:10)
}
}
