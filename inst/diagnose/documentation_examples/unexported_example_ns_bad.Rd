\name{internal_values}
\alias{internal_values}
\title{Internal Values}
\description{
An internal function whose runnable example calls it bare, though the package does not export it.
}
\usage{
internal_values(x)
}
\arguments{
\item{x}{A numeric vector.}
}
\value{
A numeric vector the length of \code{x}.
}
\examples{
internal_values(1:10)
}
